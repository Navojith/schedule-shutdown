<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ScheduleShutdown.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Schedule Shutdown">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The TitleBar control keeps the back and settings buttons clickable inside the drag region. -->
        <TitleBar
            x:Name="AppTitleBar"
            Title="Schedule Shutdown"
            BackRequested="AppTitleBar_BackRequested">
            <TitleBar.IconSource>
                <ImageIconSource x:Name="TitleIcon" />
            </TitleBar.IconSource>
            <TitleBar.RightHeader>
                <Button
                    x:Name="SettingsButton"
                    Width="40"
                    Height="32"
                    Margin="0,0,4,0"
                    Padding="0"
                    AutomationProperties.Name="Settings"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="SettingsButton_Click"
                    ToolTipService.ToolTip="Settings">
                    <FontIcon FontSize="16" Glyph="&#xE713;" />
                </Button>
            </TitleBar.RightHeader>
        </TitleBar>

        <Frame
            x:Name="ContentFrame"
            Grid.Row="1"
            Navigated="ContentFrame_Navigated" />
    </Grid>
</Window>
