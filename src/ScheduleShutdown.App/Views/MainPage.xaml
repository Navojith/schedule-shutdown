<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ScheduleShutdown.App.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    NavigationCacheMode="Required">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="24,4,24,16" Spacing="16">

                <!-- A closed InfoBar keeps its slot (and the panel spacing), so each is also collapsed while closed. -->
                <InfoBar
                    Title="Can't schedule"
                    IsOpen="{x:Bind ViewModel.IsErrorOpen, Mode=TwoWay}"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Severity="Error"
                    Visibility="{x:Bind ViewModel.IsErrorOpen, Mode=OneWay}" />

                <InfoBar
                    IsOpen="{x:Bind ViewModel.IsInfoOpen, Mode=TwoWay}"
                    Message="{x:Bind ViewModel.InfoMessage, Mode=OneWay}"
                    Severity="Informational"
                    Visibility="{x:Bind ViewModel.IsInfoOpen, Mode=OneWay}" />

                <!-- Schedule form -->
                <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsFormVisible, Mode=OneWay}">

                    <SelectorBar
                        x:Name="ModeSelector"
                        AutomationProperties.Name="Schedule mode"
                        SelectionChanged="ModeSelector_SelectionChanged">
                        <SelectorBarItem x:Name="AtTimeItem" IsSelected="True" Text="At time" />
                        <SelectorBarItem x:Name="TimerItem" Text="Timer" />
                    </SelectorBar>

                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsAtTimeMode, Mode=OneWay}">
                        <TimePicker
                            Header="Time"
                            HorizontalAlignment="Stretch"
                            Time="{x:Bind ViewModel.SelectedTime, Mode=TwoWay}" />
                        <CalendarDatePicker
                            Header="Date"
                            HorizontalAlignment="Stretch"
                            Date="{x:Bind ViewModel.SelectedDate, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsTimerMode, Mode=OneWay}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <NumberBox
                                Header="Hours"
                                Maximum="168"
                                Minimum="0"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind ViewModel.TimerHours, Mode=TwoWay}" />
                            <NumberBox
                                Grid.Column="1"
                                Header="Minutes"
                                Maximum="59"
                                Minimum="0"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind ViewModel.TimerMinutes, Mode=TwoWay}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                AutomationProperties.Name="Set timer to 15 minutes"
                                Command="{x:Bind ViewModel.ApplyPresetCommand}"
                                CommandParameter="15"
                                Content="15 min" />
                            <Button
                                AutomationProperties.Name="Set timer to 30 minutes"
                                Command="{x:Bind ViewModel.ApplyPresetCommand}"
                                CommandParameter="30"
                                Content="30 min" />
                            <Button
                                AutomationProperties.Name="Set timer to 1 hour"
                                Command="{x:Bind ViewModel.ApplyPresetCommand}"
                                CommandParameter="60"
                                Content="1 h" />
                            <Button
                                AutomationProperties.Name="Set timer to 2 hours"
                                Command="{x:Bind ViewModel.ApplyPresetCommand}"
                                CommandParameter="120"
                                Content="2 h" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <!-- Explicit name: by default it would be "Force shutdown Off", with the state read twice. -->
                        <ToggleSwitch
                            AutomationProperties.Name="Force shutdown"
                            Header="Force shutdown"
                            IsOn="{x:Bind ViewModel.Force, Mode=TwoWay}"
                            OffContent="Off"
                            OnContent="On" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Closes apps without waiting for them. Use it if an app is blocking shutdown."
                            TextWrapping="Wrap" />
                        <InfoBar
                            IsClosable="False"
                            IsOpen="{x:Bind ViewModel.Force, Mode=OneWay}"
                            Message="Unsaved work will be lost."
                            Severity="Warning"
                            Visibility="{x:Bind ViewModel.Force, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>

                <!-- Active schedule -->
                <StackPanel
                    Padding="0,16,0,0"
                    Spacing="16"
                    Visibility="{x:Bind ViewModel.IsScheduled, Mode=OneWay}">
                    <Grid
                        Width="200"
                        Height="200"
                        HorizontalAlignment="Center">
                        <ProgressRing
                            Width="200"
                            Height="200"
                            AutomationProperties.Name="Time remaining"
                            IsIndeterminate="False"
                            Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            AutomationProperties.LiveSetting="Off"
                            Style="{StaticResource TitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.RemainingText, Mode=OneWay}" />
                    </Grid>
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <StackPanel
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            AutomationProperties.Name="Postpone 10 minutes"
                            Command="{x:Bind ViewModel.PostponeCommand}"
                            Content="+10 min" />
                        <Button Command="{x:Bind ViewModel.CancelCommand}" Content="Cancel shutdown" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Pinned below the scrolling form so the force warning can't push it out of view. -->
        <Button
            Grid.Row="1"
            Margin="24,8,24,24"
            HorizontalAlignment="Stretch"
            Command="{x:Bind ViewModel.ScheduleCommand}"
            Content="Schedule shutdown"
            Style="{StaticResource AccentButtonStyle}"
            Visibility="{x:Bind ViewModel.IsFormVisible, Mode=OneWay}" />
    </Grid>
</Page>
